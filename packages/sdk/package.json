{
  "name": "@wtfalch/reporting",
  "version": "2.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Client SDK for the reporting backend a company runs for itself: send errors from a server or a Worker, read them back.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wtfalch/reporting",
    "directory": "packages/sdk"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/reader.d.ts",
    "dist/reader.js",
    "dist/sender.d.ts",
    "dist/sender.js",
    "dist/transport.d.ts",
    "dist/transport.js",
    "dist/types.d.ts",
    "dist/types.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sender": {
      "types": "./dist/sender.d.ts",
      "default": "./dist/sender.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "default": "./dist/reader.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.0",
    "vitest": "^4.1.6"
  }
}
