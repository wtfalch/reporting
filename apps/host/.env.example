# Web process: the restricted runtime role. It must not be able to alter the
# schema it serves, which is why the owner role below exists separately.
# apps/host/scripts/migrate.mjs creates or syncs this role from this very URL
# (`@wtfalch/db`'s ensureRuntimeRole); nothing else ever does, so this is the
# only place its username and password are decided. Its `search_path` is set to
# `reporting, public`, and it is granted schema `reporting` only. The pool is
# capped (5 connections) and every statement is cut off at 15 s, because one
# Postgres serves many services.
DATABASE_URL=postgres://reporting_rt:replace-me@localhost:5432/reporting

# The owner role. The migrate step only (migrate.mjs); start.sh strips it from
# the environment before the server starts, so the server never holds it.
DATABASE_URL_OWNER=postgres://reporting_owner:replace-me@localhost:5432/reporting

# The operator key. foundry generates it, sends it as `Authorization: Bearer
# <key>` to POST /v1/site-keys and DELETE /v1/site-keys/:id, and delivers it to
# Boule for the error reads. Unset or empty, every operator route refuses every
# caller. Never put it in a log, a response or an app's env.
REPORTING_OPERATOR_KEY=replace-me-with-a-long-random-value

# This company's sign-in organisation. Its one tenant id is derived from it and
# written on every site key and every row in this database. Unset, minting
# answers 503.
AUTH_ORGANIZATION_ID=000000000000000000

NODE_ENV=production
